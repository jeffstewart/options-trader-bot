# ==============================================================================
# Trader Bot v3 — Starter Configuration Template
# Copy this file to .env and fill in your API credentials:
#   cp v3/.env.example v3/.env
# ==============================================================================

# ── Alpaca Paper Trading Credentials ──────────────────────────────────────────
# Obtain your free paper trading keys at https://app.alpaca.markets/paper-trading
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# ── Simulation Mode ───────────────────────────────────────────────────────────
# Set DRY_RUN=1 to simulate order executions without placing actual orders
DRY_RUN=0

# ── LLM Scorer Provider Configuration ────────────────────────────────────────
# Supported providers: 'ollama' | 'gemini' | 'anthropic' | 'moonshot'
SCORER_PROVIDER=ollama
SCORER_MODEL=llama3.2
SCORER_TIMEOUT_S=25.0
SCORER_MAX_RETRIES=3

# ── Local Ollama Settings ─────────────────────────────────────────────────────
# For native execution: http://localhost:11434/v1
# For Docker/Colima container execution: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ── Cloud LLM Provider Keys (Optional — required only if chosen as provider) ──
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PACING_SECS=4.5
GEMINI_MAX_DAILY_CALLS=120

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Moonshot AI: https://platform.moonshot.cn/
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# ── News Context & Lookback Window ────────────────────────────────────────────
# Number of trailing days of ticker-specific news history to send to the LLM
NEWS_LOOKBACK_DAYS=7

# Maximum number of prior articles per ticker included in the prompt
NEWS_MAX_TICKER_ARTICLES=10
