# ==============================================================================
# Trader Bot — Global Environment Configuration Template
# Copy this file to .env and insert your API credentials:
#   cp .env.example .env
# ==============================================================================

# ── Alpaca Paper Trading Credentials (Required) ───────────────────────────────
# Sign up and generate free paper API keys at:
# https://app.alpaca.markets/paper-trading/overview
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# ── Simulation & Dry Run Mode ─────────────────────────────────────────────────
# Set to 1 to simulate fills and orders without submitting to Alpaca
DRY_RUN=0

# ── Local Ollama Scorer (Zero Marginal Cost) ───────────────────────────────────
# Run 'ollama serve' and 'ollama pull llama3.2' on the host
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ── v3 Scorer Selection & Context Parameters ──────────────────────────────────
# Provider choices: 'ollama' | 'gemini' | 'anthropic' | 'moonshot'
SCORER_PROVIDER=ollama
SCORER_MODEL=llama3.2
NEWS_LOOKBACK_DAYS=7
NEWS_MAX_TICKER_ARTICLES=10

# ── Google Gemini API (Optional) ──────────────────────────────────────────────
# Generate an API key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PACING_SECS=4.5
GEMINI_MAX_DAILY_CALLS=120

# ── Anthropic Claude API (Optional) ───────────────────────────────────────────
# Generate an API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Moonshot AI / Kimi API (Optional) ─────────────────────────────────────────
# Generate an API key at https://platform.moonshot.cn/
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# ── OpenAI API (Optional) ─────────────────────────────────────────────────────
# Generate an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Mistral AI API (Optional — used in v1 confirm/veto gate) ──────────────────
# Generate an API key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── Groq API (Optional — fast inference experimentation) ──────────────────────
# Generate an API key at https://console.groq.com/keys
LAB_HOSTED_KEY=your_groq_api_key_here
LAB_HOSTED_MODEL=llama-3.1-8b-instant
LAB_HOSTED_BASE_URL=https://api.groq.com/openai/v1

# ── NewsAPI (Optional external supplementary feed) ───────────────────────────
# Obtain a free key at https://newsapi.org (leave blank to disable)
NEWSAPI_KEY=your_newsapi_key_here

# ── SEC EDGAR User-Agent (v1/v2 RSS Feed Ingestion) ───────────────────────────
SEC_USER_AGENT=TraderBot your_email@example.com
